{
  "name": "self-component",
  "version": "0.1.0",
  "description": "Personal React component library built on shadcn/ui primitives",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./src/styles/globals.css"
  },
  "files": [
    "dist",
    "src/styles"
  ],
  "engines": {
    "node": ">=20"
  },
  "packageManager": "npm@11.5.2",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.build.json",
    "build:clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && npm run build",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run build && npm run format:check",
    "lint": "eslint src preview",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "ui:add": "npx shadcn@latest add",
    "changeset": "changeset add",
    "changeset:empty": "changeset add --empty",
    "version": "changeset version",
    "changeset:status": "changeset status --since=origin/dev",
    "changeset:status:main": "changeset status --since=origin/main",
    "prepare": "husky"
  },
  "peerDependencies": {
    "@radix-ui/react-dialog": "^1.1.0",
    "@radix-ui/react-label": "^2.1.0",
    "@radix-ui/react-popover": "^1.1.0",
    "@radix-ui/react-slot": "^1.1.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.0",
    "cmdk": "^1.0.0",
    "lucide-react": "^0.475.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "react-hook-form": "^7.0.0",
    "tailwind-merge": "^2.0.0 || ^3.0.0",
    "tailwindcss": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "react-hook-form": {
      "optional": true
    }
  },
  "devDependencies": {
    "@changesets/cli": "2.31.0",
    "@commitlint/cli": "21.1.0",
    "@commitlint/config-conventional": "21.1.0",
    "@radix-ui/react-dialog": "1.1.17",
    "@radix-ui/react-label": "2.1.10",
    "@radix-ui/react-popover": "1.1.17",
    "@radix-ui/react-slot": "1.3.0",
    "@tailwindcss/postcss": "4.3.1",
    "@types/node": "22.20.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "4.7.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "eslint": "9.39.4",
    "husky": "9.1.7",
    "lucide-react": "0.475.0",
    "postcss": "8.5.15",
    "prettier": "3.8.4",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-hook-form": "7.71.2",
    "react-router-dom": "7.18.0",
    "tailwind-merge": "3.6.0",
    "tailwindcss": "4.3.1",
    "tailwindcss-animate": "1.0.7",
    "typescript": "5.9.3",
    "vite": "6.4.3"
  },
  "license": "MIT"
}
